    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\n\r\n# =========================================================\r\n# REVIT API\r\n# =========================================================\r\nclr.AddReference(\"RevitAPI\")\r\nfrom Autodesk.Revit.DB import *\r\n\r\n# =========================================================\r\n# REVIT SERVICES\r\n# =========================================================\r\nclr.AddReference(\"RevitServices\")\r\nfrom RevitServices.Persistence import DocumentManager\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\n# =========================================================\r\n# ENTRADA\r\n# IN[0] = elementos de Revit\r\n# =========================================================\r\nelementos = IN[0]\r\n\r\nif not isinstance(elementos, list):\r\n    elementos = [elementos]\r\n\r\n# =========================================================\r\n# TABLA\r\n# =========================================================\r\ntabla = [\r\n    [\"Categoria\", \"Familia\", \"Tipo\", \"ID\"]\r\n]\r\n\r\n# =========================================================\r\n# RECORRER ELEMENTOS\r\n# =========================================================\r\nfor elemento in elementos:\r\n\r\n    try:\r\n        el = UnwrapElement(elemento)\r\n\r\n        if el is None:\r\n            continue\r\n\r\n        # -------------------------------------------------\r\n        # CATEGORIA\r\n        # -------------------------------------------------\r\n        categoria = \"Sin categoria\"\r\n\r\n        try:\r\n            if el.Category is not None:\r\n                categoria = el.Category.Name\r\n        except:\r\n            pass\r\n\r\n        # -------------------------------------------------\r\n        # ID\r\n        # -------------------------------------------------\r\n        elemento_id = \"\"\r\n\r\n        try:\r\n            elemento_id = el.Id.Value\r\n        except:\r\n            try:\r\n                elemento_id = el.Id.IntegerValue\r\n            except:\r\n                pass\r\n\r\n        # -------------------------------------------------\r\n        # VALORES INICIALES\r\n        # -------------------------------------------------\r\n        familia = \"Sin familia\"\r\n        tipo = \"Sin tipo\"\r\n\r\n        # -------------------------------------------------\r\n        # OBTENER TIPO DEL ELEMENTO\r\n        # -------------------------------------------------\r\n        try:\r\n            type_id = el.GetTypeId()\r\n\r\n            if type_id != ElementId.InvalidElementId:\r\n\r\n                element_type = doc.GetElement(type_id)\r\n\r\n                if element_type is not None:\r\n\r\n                    # =====================================\r\n                    # FAMILIA\r\n                    # =====================================\r\n                    try:\r\n                        p_familia = element_type.get_Parameter(\r\n                            BuiltInParameter.ALL_MODEL_FAMILY_NAME\r\n                        )\r\n\r\n                        if p_familia is not None:\r\n                            valor = p_familia.AsString()\r\n\r\n                            if valor:\r\n                                familia = valor\r\n                    except:\r\n                        pass\r\n\r\n                    # Si no encontró familia\r\n                    if familia == \"Sin familia\":\r\n                        try:\r\n                            familia = element_type.FamilyName\r\n                        except:\r\n                            try:\r\n                                familia = element_type.Family.Name\r\n                            except:\r\n                                pass\r\n\r\n                    # =====================================\r\n                    # TIPO\r\n                    # =====================================\r\n                    try:\r\n                        p_tipo = element_type.get_Parameter(\r\n                            BuiltInParameter.ALL_MODEL_TYPE_NAME\r\n                        )\r\n\r\n                        if p_tipo is not None:\r\n                            valor_tipo = p_tipo.AsString()\r\n\r\n                            if valor_tipo:\r\n                                tipo = valor_tipo\r\n                    except:\r\n                        pass\r\n\r\n                    # -------------------------------------\r\n                    # MÉTODO ALTERNATIVO\r\n                    # -------------------------------------\r\n                    if tipo == \"Sin tipo\":\r\n                        try:\r\n                            p_tipo = element_type.get_Parameter(\r\n                                BuiltInParameter.SYMBOL_NAME_PARAM\r\n                            )\r\n\r\n                            if p_tipo is not None:\r\n                                valor_tipo = p_tipo.AsString()\r\n\r\n                                if valor_tipo:\r\n                                    tipo = valor_tipo\r\n                        except:\r\n                            pass\r\n\r\n                    # -------------------------------------\r\n                    # ÚLTIMO MÉTODO\r\n                    # -------------------------------------\r\n                    if tipo == \"Sin tipo\":\r\n                        try:\r\n                            tipo = Element.Name.GetValue(element_type)\r\n                        except:\r\n                            pass\r\n\r\n        except:\r\n            pass\r\n\r\n        # -------------------------------------------------\r\n        # AGREGAR FILA\r\n        # -------------------------------------------------\r\n        tabla.append([\r\n            categoria,\r\n            familia,\r\n            tipo,\r\n            elemento_id\r\n        ])\r\n\r\n    except:\r\n        pass\r\n\r\n# =========================================================\r\n# SALIDA\r\n# =========================================================\r\nOUT = tabla",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "85acf6b28d244814986ec6f5fa51db5b",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "8f5bd7999c4a4d039505072667323c9d",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "342920e010984064886590b788705403",
          "Name": "OUT",
          "Description": "Result of the python script",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Runs an embedded Python script."
